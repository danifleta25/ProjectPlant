<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.projectplant.projectplant.presentation.controller.LoginController">
   <children>
      <VBox alignment="CENTER" layoutX="119.0" layoutY="47.0" prefHeight="314.0" prefWidth="358.0" spacing="15.0">
         <children>
            <Label text="ProjectPlant">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Usuario" />
            <TextField fx:id="txtUsername" promptText="Introduce tu usuario" />
            <Label text="Contraseña" />
            <PasswordField fx:id="txtPassword" promptText="Introduce tu contraseña" />
            <Button mnemonicParsing="false" onAction="#handleLogin" text="Iniciar sesión" />
         </children>
      </VBox>
   </children>
</AnchorPane>
